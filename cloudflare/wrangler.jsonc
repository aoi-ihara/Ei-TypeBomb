{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "ei-typebomb",
	"main": "src/index.ts",
	"compatibility_date": "2026-09-26",
	"durable_objects": {
		"bindings": [{ "name": "GAME_ROOMS", "class_name": "GameRoom" }],
	},
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["MyDurableObject"] },
		{ "tag": "v2", "new_sqlite_classes": ["GameRoom"], "deleted_classes": ["MyDurableObject"] },
	],
	"vars": {
		"ALLOWED_ORIGINS": "http://localhost:3000,https://ei-typebomb.vgnz93hs.com,https://beta.ei-typebomb.vgnz93hs.com",
	},
	"observability": { "enabled": true },
	"upload_source_maps": true,
}
