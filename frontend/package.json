{
    "name": "client",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run test:import && npm run test:kana && npm run test:bot-typing && npm run test:editor && npm run test:room-cache && npm run test:room-list && next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "node scripts/fix-word-drag.mjs",
        "test:playground": "node scripts/test-learning.mjs all",
        "test:selection-browser": "playwright test",
        "test:kana": "node --test test/romaji-input.test.mjs",
        "test:import": "node --test test/import-words.test.mjs",
        "test:bot-typing": "node --test test/bot-typing.test.mjs",
        "test:mcp-oauth": "node --test test/account-auth.test.cjs test/posthog-identity.test.cjs test/mcp-etb-auth.test.cjs test/mcp-oauth-discovery.test.mjs && tsx --test test/mcp-oauth-diagnostics.test.mts",
        "test:account": "node --test test/account-auth.test.cjs test/posthog-identity.test.cjs",
        "test:room-list": "node --test test/beta-access.test.cjs test/public-feed-isr.test.cjs && tsx --test test/room-list.test.mts",
        "test:room-cache": "node --test test/public-room-cache.test.cjs test/room-data-cache.test.cjs test/room-delete-security.test.cjs",
        "test:editor": "node --test test/room-update-security.test.cjs && tsx --test test/editor-rebase.test.mts test/partial-update.test.mts test/room-readings.test.mts",
        "check:mcp-oauth": "node scripts/check-mcp-oauth.mjs",
        "test:mcp-server": "tsx --test test/mcp-authorization-server.test.mts test/mcp-database-tls.test.mts",
        "generate:mcp-keys": "node scripts/generate-mcp-keys.mjs",
        "test:mcp-tls": "tsx --test test/mcp-database-tls.test.mts",
        "test:fsrs": "tsx --test test/fsrs7-engine.test.mts",
        "test:learning": "node scripts/test-learning.mjs learning",
        "test:game": "node scripts/test-learning.mjs game",
        "test:simulation": "node scripts/test-learning.mjs simulation",
        "test:simulation:long": "ETB_LONG_SIMULATION=1 node scripts/test-learning.mjs simulation",
        "simulate:learning": "tsx scripts/simulate-learning.mts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@flags-sdk/vercel": "^1.6.1",
        "@google/genai": "^1.52.0",
        "@marsidev/react-turnstile": "^1.6.3",
        "@posthog/ai": "^8.22.0",
        "@posthog/mcp": "1.6.1",
        "@posthog/react": "^1.11.3",
        "@supabase/ssr": "^0.12.7",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.1.0",
        "argon2": "^0.45.2",
        "express": "^5.3.0",
        "flags": "^4.5.0",
        "framer-motion": "^12.43.0",
        "gray-matter": "^4.0.3",
        "jose": "^6.2.18",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.77.0",
        "marked": "^18.2.1",
        "next": "^16.4.6",
        "oidc-provider": "9.15.1",
        "pg": "^8.23.1",
        "posthog-js": "^1.453.2",
        "posthog-node": "^5.74.0",
        "qrcode.react": "^4.2.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-markdown": "^10.1.0",
        "socket.io": "^4.8.4",
        "socket.io-client": "^4.8.4",
        "validator": "^13.15.35",
        "zod": "^4.6.7",
        "tinyld": "1.3.4",
        "ts-fsrs": "6.0.0"
    },
    "devDependencies": {
        "@playwright/test": "^1.65.1",
        "@tailwindcss/postcss": "^4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20",
        "@types/oidc-provider": "9.13.1",
        "@types/pg": "8.23.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/validator": "^13.15.10",
        "electron": "^42.11.18",
        "electron-builder": "^26.18.1",
        "esbuild": "^0.28.2",
        "eslint": "^9",
        "eslint-config-next": "16.4.6",
        "tailwindcss": "^4",
        "tsx": "4.23.15",
        "typescript": "^5"
    },
    "engines": {
        "node": "24.x"
    }
}
