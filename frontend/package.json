{
    "name": "client",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "npm run test:import && npm run test:kana && npm run test:bot-typing && npm run test:editor && next build",
        "start": "next start",
        "lint": "eslint",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "postinstall": "node scripts/fix-word-drag.mjs",
        "test:playground": "node --test test/playground.test.cjs test/online-memory.test.cjs test/retry-gap.test.cjs test/automatic-hint-evidence.test.cjs && tsx --test test/answer-mode.test.mts",
        "test:kana": "node --test test/romaji-input.test.mjs",
        "test:import": "node --test test/import-words.test.mjs",
        "test:bot-typing": "node --test test/bot-typing.test.mjs",
        "test:mcp-oauth": "node --test test/account-auth.test.cjs test/mcp-etb-auth.test.cjs test/mcp-oauth-discovery.test.mjs && tsx --test test/mcp-oauth-diagnostics.test.mts",
        "test:account": "node --test test/account-auth.test.cjs",
        "test:room-list": "tsx --test test/room-list.test.mts",
        "test:editor": "tsx --test test/editor-rebase.test.mts",
        "check:mcp-oauth": "node scripts/check-mcp-oauth.mjs",
        "test:mcp-server": "tsx --test test/mcp-authorization-server.test.mts test/mcp-database-tls.test.mts",
        "generate:mcp-keys": "node scripts/generate-mcp-keys.mjs",
        "test:mcp-tls": "tsx --test test/mcp-database-tls.test.mts"
    },
    "dependencies": {
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@flags-sdk/vercel": "^1.4.7",
        "@google/genai": "^1.52.0",
        "@marsidev/react-turnstile": "^1.5.3",
        "@posthog/ai": "^8.13.4",
        "@posthog/react": "^1.11.3",
        "@supabase/ssr": "^0.12.3",
        "@vercel/analytics": "^2.0.1",
        "@vercel/speed-insights": "^2.0.0",
        "argon2": "^0.45.1",
        "express": "^5.2.1",
        "flags": "^4.3.0",
        "framer-motion": "^12.40.0",
        "gray-matter": "^4.0.3",
        "jose": "^6.2.3",
        "jsonwebtoken": "^9.0.3",
        "lucide-react": "^1.61.0",
        "marked": "^18.1.3",
        "next": "^16.3.0",
        "oidc-provider": "9.13.3",
        "pg": "^8.16.3",
        "posthog-js": "^1.438.7",
        "posthog-node": "^5.52.1",
        "qrcode.react": "^4.2.0",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "react-markdown": "^10.1.0",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "validator": "^13.15.35",
        "zod": "^4.5.4"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^20",
        "@types/oidc-provider": "9.13.1",
        "@types/pg": "8.23.1",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@types/validator": "^13.15.10",
        "electron": "^42.4.0",
        "electron-builder": "^26.15.2",
        "eslint": "^9",
        "eslint-config-next": "16.2.6",
        "tailwindcss": "^4",
        "tsx": "4.23.15",
        "typescript": "^5"
    },
    "engines": {
        "node": "22.x"
    }
}
