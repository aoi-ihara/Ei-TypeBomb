{
    "compilerOptions": {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "rootDir": "..",
        "outDir": "dist",
        "allowJs": true,
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "types": ["node"],
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"],
}
