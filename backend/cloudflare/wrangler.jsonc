{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "ei-typebomb",
    "main": "src/index.ts",
    "compatibility_date": "2026-10-16",
    "durable_objects": {
        "bindings": [
            {
                "name": "CLUSTER",
                "class_name": "ClusterDO",
            },
            { "name": "REPLICAS", "class_name": "ReplicaDO" },
            {
                "name": "ROOMS",
                "class_name": "GameRoom",
            },
        ],
    },
    "routes": [
        {
            "pattern": "secondary-server.ei-typebomb.com",
            "zone_name": "ei-typebomb.com",
            "custom_domain": true,
        },
    ],
    "triggers": { "crons": ["* * * * *"] },
    "observability": {
        "enabled": true,
        "logs": { "enabled": true },
    },
    "keep_vars": true,
    "migrations": [
        {
            "tag": "v1",
            "new_sqlite_classes": ["RoomDO"],
        },
        {
            "tag": "distributed-v2",
            "new_sqlite_classes": ["ClusterDO", "ReplicaDO"],
        },
    ],
    "previews": {
        "durable_objects": {
            "bindings": [
                {
                    "name": "CLUSTER",
                    "class_name": "ClusterDO",
                },
                { "name": "REPLICAS", "class_name": "ReplicaDO" },
                {
                    "name": "ROOMS",
                    "class_name": "RoomDO",
                },
            ],
        },
    },
}
