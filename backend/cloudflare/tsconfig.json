{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022"],
        "types": ["@cloudflare/workers-types"],
        "allowJs": true,
        "strict": true,
        "skipLibCheck": true,
        "noEmit": true,
    },
    "include": ["src/**/*.ts", "../shared/**/*.ts"],
}
